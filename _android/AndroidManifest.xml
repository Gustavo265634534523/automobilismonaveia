<?xml version="1.0" encoding="utf-8"?>
<!-- App do Automobilismo Na Veia para Android: abre o site e traz o widget da tela inicial.
     Só é baixado pelo site (automobilismonaveia.com.br/widget.html), não fica na Play Store. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.com.automobilismonaveia.app">

  <uses-permission android:name="android.permission.INTERNET" />

  <application
      android:label="@string/nome"
      android:icon="@mipmap/ic_launcher"
      android:theme="@style/Tema"
      android:allowBackup="true"
      android:usesCleartextTraffic="false">

    <activity
        android:name=".Principal"
        android:exported="true"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <activity
        android:name=".Configurar"
        android:exported="true"
        android:label="@string/configurar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <receiver
        android:name=".Widget"
        android:exported="true"
        android:label="@string/nome">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_info" />
    </receiver>
  </application>
</manifest>
